{
  "comment": "Maps node-harness assertion names (from run_tests.sh ok/fail/skip) to registry feature ids. Matched by longest-prefix against the ledger name (so 'busybox echo (exit 1)' still maps to busybox.echo). Unmapped names (e.g. MemFS unit tests) are skipped by the emitter.",
  "contract": 1,
  "map": {
    "hello": ["emulator.elf.load"],
    "test_suite": ["emulator.cpu.decode-rv64"],
    "test_rvc": ["emulator.cpu.decode-rvc"],
    "test_memory": ["emulator.mem.bounds"],
    "test_syscalls": ["emulator.process.exit"],
    "test_float": ["emulator.cpu.fpu"],
    "busybox echo": ["busybox.echo"],
    "busybox true": ["busybox.true"],
    "busybox false": ["busybox.false"],
    "busybox uname": ["busybox.uname", "emulator.syscall.uname"],
    "busybox basename": ["busybox.basename"],
    "busybox dirname": ["busybox.dirname"],
    "busybox cat": ["busybox.cat"],
    "busybox head": ["busybox.head"],
    "busybox tail": ["busybox.tail"],
    "busybox sort": ["busybox.sort"],
    "busybox id": ["busybox.id"],
    "busybox pwd": ["busybox.pwd", "emulator.syscall.getcwd"],
    "busybox env": ["busybox.env"],
    "busybox whoami": ["busybox.whoami"],
    "busybox hostname": ["busybox.hostname"],
    "busybox printf": ["busybox.printf"],
    "busybox seq": ["busybox.seq"],
    "devenv node": ["devenv.node"],
    "devenv npm": ["devenv.npm"],
    "devenv tsc": ["devenv.tsc"],
    "devenv eslint": ["devenv.eslint"],
    "devenv prettier": ["devenv.prettier"]
  }
}
