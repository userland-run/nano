{
  "name": "nano-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "mkdir -p public && cp ../../wasm/nano.wasm public/nano.wasm",
    "deploy": "npm run predeploy && npm run build && echo '' > dist/.gitignore && npx gh-pages -d dist --dotfiles --no-history"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@react-spectrum/s2": "^1.0.0",
    "allotment": "^1.20.5",
    "codemirror": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "unplugin-parcel-macros": "^0.1.0",
    "vite": "^6.0.0"
  }
}
